<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome AG monogram.

  Stroked, untinted (black) and free of the baked shadow/halo of the launcher
  PNG, so `Icon(painterResource(...), tint = colors.text)` keeps the mark above
  10:1 on every theme instead of vanishing on light paper.

  Both letters share one cap height (y = 5..19) and one stroke (1.9). The `G`
  needs its own horizontal bar and a right leg: without them the half-height
  bowl read as "Ao" / "Aa" on every theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- A: two full-height stems plus a crossbar below the optical middle. -->
    <path
        android:pathData="M2.5,19 L6.5,5 L10.5,19"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M3.9,14.5 L9.1,14.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <!-- G: full-height C-bowl, horizontal bar inward at y = 12.5, right leg up. -->
    <path
        android:pathData="M20.2,7.3 A4.1,6.8 0 1 0 20.2,16.7 L21.5,16.7 L21.5,12.5 L17.5,12.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
