  "import_success_cases": [
    { "name": "theme_only", "input": "{\"theme\":\"oled\"}", "expected_theme": "oled" },
    {
      "name": "accent_and_radius",
      "input": "{\"custom_accent\":\"#34D399\",\"corner_radius\":5,\"density\":\"SPACIOUS\"}",
      "expected_theme": "system",
      "expected_accent": "#34d399",
      "expected_corner_radius": 6,
      "expected_density": "spacious"
    }
  ],
  "import_error_cases": [
    { "name": "broken_json", "input": "{\"theme\":", "ok": false, "error_code": "invalid" },
    { "name": "empty_string", "input": "", "ok": false, "error_code": "invalid" },
    { "name": "array_root", "input": "[]", "ok": false, "error_code": "invalid" },
    { "name": "number_root", "input": "42", "ok": false, "error_code": "invalid" },
    { "name": "string_root", "input": "\"x\"", "ok": false, "error_code": "invalid" },
